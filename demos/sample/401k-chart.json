{
  "extends": "../../sites/sample-signed-in.json",
  "description": "Signed in: ask the assistant about 401(k) contributions, then open the chart follow-up. Balances are blurred.",
  "steps": [
    {"action": "caption", "text": "Ask about your 401(k)"},
    {"action": "click", "target": {"role": "button", "name": "Open Assistant"}},
    {"action": "type", "target": {"frame": "#panel", "placeholder": "Ask a question"}, "text": "How much have I contributed to my 401(k) this year?", "submit": true},
    {"action": "waitForStable", "target": {"frame": "#panel", "css": ".answer"}, "pauseAfter": 3000},
    {"action": "caption", "text": "Follow-ups turn answers into charts"},
    {"action": "click", "target": {"frame": "#panel", "role": "button", "name": "Show me a chart"}},
    {"action": "waitForStable", "target": {"frame": "#panel", "css": ".answer"}, "pauseAfter": 2500},
    {"action": "caption", "text": null}
  ]
}
